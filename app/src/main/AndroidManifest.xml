<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The receiver needs the camera. Nothing else is requested: NG7 rules out network code of
         any kind, including for capability exchange, so there is deliberately no INTERNET
         permission and adding one would contradict the project's premise. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <!-- Manual sensor control is what locks exposure/ISO/focus for the session. Not required:
         RISK-011 says the flag is unreliable, so the probe verifies by measurement and the app
         degrades rather than refusing to install. -->
    <uses-feature
        android:name="android.hardware.camera.capability.manual_sensor"
        android:required="false" />

    <application
        android:label="FileFlow"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The capture run (C05 CPU path, EXP-007's verification half). Exported so a run is
             scriptable from adb with its parameters as extras: a measurement whose parameters
             live in someone's memory rather than in its report is not reproducible. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- The transmitter (C03). Fullscreen, portrait-locked and orientation-change-proof: a
             re-layout mid-run would resize the surface and change the cell pitch, which the
             receiver would see as the geometry moving under it.

             `configChanges` deliberately includes `screenSize` so the activity is NOT recreated on
             a configuration change; ADR-0004 requires the surface stay at native resolution with no
             scaling for the whole session. -->
        <!-- Live aiming guidance (UI-02). Exported so a session is scriptable, and
             portrait-locked because the schematic assumes a fixed screen orientation. -->
        <activity
            android:name=".AimActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".TransmitActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
    </application>
</manifest>
